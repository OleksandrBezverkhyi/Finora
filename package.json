{
  "name": "finora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "docs:check": "node scripts/check-documentation.mjs",
    "docs:generate": "jsdoc -c jsdoc.config.json",
    "docs:test": "node --experimental-default-type=module --test tests/documentation/*.test.js",
    "docs:verify": "npm run docs:check && npm run docs:test",
    "prepare": "husky",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcrypt": "^6.0.0",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@tailwindcss/postcss": "^4",
    "dotenv": "^17.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "jsdoc": "^4.0.4",
    "lint-staged": "^15.5.2",
    "prettier": "^3",
    "prisma": "^7.0.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
}
